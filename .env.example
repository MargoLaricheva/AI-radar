# ===== Telegram =====
# Токен бота из BotFather (обязателен)
BOT_TOKEN=
# Telegram user_id владельца (число). Пусто -> привязка первым /start
OWNER_ID=

# ===== База данных =====
DATABASE_URL=postgres://radar:radar@db:5432/radar

# ===== LLM (opencode go / OpenAI-совместимый) =====
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_COST_IN=0.2
LLM_COST_OUT=0.6

# ===== Безопасность =====
# Ключ шифрования session (AES-256-GCM). Пусто -> генерируется в data/key.bin (0600)
SESSION_KEY=

# ===== Мониторинг =====
MONITOR_CHAT_LIMIT=100
CHAT_MSG_PER_MIN_CAP=60
CATCHUP_HOURS=6

# ===== Анализ =====
ANALYSIS_PER_HOUR=30
THREAD_ANALYSES_PER_DAY=4
SEGMENT_GAP_MIN=45
DEBOUNCE_QUIET_MIN=5
DEBOUNCE_MAX_AGE_MIN=20
THREAD_TTL_HOURS=12
FILTER_THRESHOLD=0.30
USE_LLM_FILTER=false

# ===== Уведомления и дайджест =====
NOTIFY_LEVEL=opportunities
QUIET_HOURS=23:00-09:00
DIGEST_TIME=09:00

# ===== Хранение =====
RETENTION_DAYS=30

# ===== Сервис =====
LOG_LEVEL=info
PORT=3000
TZ=Europe/Moscow
